---
import AuthMenu from "./AuthMenu.tsx";

const links = [
  { href: "/discover", label: "Discover" },
  { href: "/feed", label: "Friends" },
  { href: "/watched", label: "My log" },
  { href: "/favorites", label: "Favorites" },
];
---

<header class="border-border/60 bg-surface/70 sticky top-0 z-20 border-b backdrop-blur-xl">
  <nav class="mx-auto grid w-full max-w-5xl grid-cols-[1fr_auto_auto] items-center gap-2 px-4 py-3 sm:px-6 lg:flex lg:justify-between lg:px-8 lg:py-4">
    <a
      href="/"
      class="text-text-primary group flex min-w-0 items-center gap-2.5 text-base font-extrabold tracking-tight lg:gap-3 lg:text-lg"
    >
      <span class="from-brand-400 to-brand-600 shadow-accent/30 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-linear-to-br text-base shadow-lg transition group-hover:scale-105">
        🎬
      </span>
      <span class="truncate">Next Watch</span>
    </a>

    <div class="text-text-muted hidden items-center gap-2 text-base font-medium lg:flex">
      {links.map((link) => (
        <a
          href={link.href}
          class="hover:text-text-primary whitespace-nowrap rounded-full px-3.5 py-2 transition"
        >
          {link.label}
        </a>
      ))}
    </div>

    <!-- Native disclosure keeps mobile navigation keyboard-accessible without
         shipping menu-state JavaScript. -->
    <details class="group lg:hidden">
      <summary
        class="border-border/60 hover:border-accent focus-visible:outline-accent grid h-10 w-10 cursor-pointer list-none place-items-center rounded-full border transition focus-visible:outline-2 focus-visible:outline-offset-2 [&::-webkit-details-marker]:hidden"
        aria-label="Navigation menu"
      >
        <span class="sr-only">Navigation menu</span>
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
          class="h-5 w-5 group-open:hidden"
        >
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
          class="hidden h-5 w-5 group-open:block"
        >
          <path d="m6 6 12 12M18 6 6 18"></path>
        </svg>
      </summary>
      <div class="border-border/60 bg-surface-elevated absolute inset-x-0 top-full border-b p-3 shadow-xl">
        <div class="mx-auto grid max-w-5xl gap-1">
          {links.map((link) => (
            <a
              href={link.href}
              class="text-text-secondary hover:bg-surface-muted hover:text-text-primary focus-visible:outline-accent flex min-h-11 items-center rounded-xl px-4 font-semibold transition focus-visible:outline-2 focus-visible:outline-offset-[-2px]"
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </details>

    <div class="justify-self-end lg:order-3">
      <AuthMenu client:load transition:persist="auth-menu" />
    </div>
  </nav>
</header>
