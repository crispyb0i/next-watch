---
export const prerender = false;
import { isMissingSchema } from "../../lib/server/schemaErrors";
import { mediaHref } from "../../lib/mediaHref";

import { and, count, desc, eq } from "drizzle-orm";
import Layout from "../../layouts/Layout.astro";
import MediaCard from "../../components/MediaCard.tsx";
import FollowButton from "../../components/FollowButton.tsx";
import ProfileRuntime from "../../components/ProfileRuntime.tsx";
import ProfileStars from "../../components/ProfileStars.astro";
import ReviewContent from "../../components/ReviewContent";
import { db } from "../../db";
import { favorites, reviews, users, viewingPreferences } from "../../db/schema";
import { displayName, followState } from "../../lib/follows";
import {
  activityHref,
  activityLabel,
  activityText,
  profilePage,
  runtimePath,
} from "../../lib/profileActivity";
import { reviewHref } from "../../lib/reviews";
import { listWatched } from "../api/watched";
import "../../styles/global.css";

// Favorites change under this page, so never serve it from the HTTP cache.
Astro.response.headers.set("cache-control", "no-store");

const { id } = Astro.params;
let page: ReturnType<typeof profilePage>;
try {
  page = profilePage(Astro.url.searchParams);
} catch {
  return new Response("Invalid profile page", { status: 400 });
}
const { view, limit, offset } = page;
const profileHref = `/u/${encodeURIComponent(id ?? "")}`;
const pageHref = (section: "watched" | "reviews", start = 0) =>
  `${profileHref}?view=${section}&offset=${start}#activity`;

const [user] = id
  ? await db.select().from(users).where(eq(users.id, id)).limit(1)
  : [];

if (!user) return new Response("User not found", { status: 404 });

const [rows, logRows, follow, reviewCount, reviewRows] = await Promise.all([
  db
    .select({
      tmdbId: favorites.tmdbId,
      mediaType: favorites.mediaType,
      title: favorites.title,
      poster: favorites.poster,
      subtitle: favorites.subtitle,
      rating: favorites.rating,
      href: favorites.href,
    })
    .from(favorites)
    .where(and(eq(favorites.userId, user.id), eq(favorites.kind, "favorite")))
    .orderBy(desc(favorites.createdAt)),
  listWatched(user.id)
    .limit(limit + 1)
    .offset(view === "watched" ? offset : 0),
  // Counts only: the viewer is unknown server-side (no bearer token on page
  // requests), so FollowButton resolves its own state after mount.
  followState(user.id, null),
  db
    .select({ n: count() })
    .from(reviews)
    .where(and(eq(reviews.userId, user.id), eq(reviews.status, "published")))
    .then(([row]) => row?.n ?? 0),
  db
    .select({
      id: reviews.id,
      tmdbId: reviews.tmdbId,
      mediaType: reviews.mediaType,
      season: reviews.season,
      episode: reviews.episode,
      title: reviews.title,
      poster: reviews.poster,
      subtitle: reviews.subtitle,
      rating: reviews.rating,
      review: reviews.review,
      document: reviews.document,
      updatedAt: reviews.updatedAt,
    })
    .from(reviews)
    .where(and(eq(reviews.userId, user.id), eq(reviews.status, "published")))
    .orderBy(desc(reviews.updatedAt), desc(reviews.id))
    .limit(limit + 1)
    .offset(view === "reviews" ? offset : 0),
]);
const log = logRows.slice(0, limit);
const reviewList = reviewRows.slice(0, limit);
const hasNextPage = (view === "watched" ? logRows : reviewRows).length > limit;

const [preferences] = await db
  .select()
  .from(viewingPreferences)
  .where(eq(viewingPreferences.userId, user.id))
  .catch((error: unknown) => {
    // Keep existing profiles working while optional feature migrations are pending.
    // With no verified preference, the watchlist stays private.
    if (isMissingSchema(error)) return [];
    throw error;
  });
const publicWatchlist = preferences?.watchlistPublic
  ? await db
      .select()
      .from(favorites)
      .where(
        and(eq(favorites.userId, user.id), eq(favorites.kind, "watchlist")),
      )
      .limit(100)
  : [];
const name = displayName(user);
const initials = name.slice(0, 2).toUpperCase();

const formatDate = (value: string | Date) => {
  const date =
    value instanceof Date
      ? value
      : /^\d{4}-\d{2}-\d{2}$/.test(value)
        ? new Date(`${value}T00:00:00`)
        : new Date(value);
  if (Number.isNaN(date.getTime())) return "Date unavailable";
  return date.toLocaleDateString(undefined, {
    day: "numeric",
    month: "short",
    year: "numeric",
  });
};
---

<Layout>
  <div class="w-full">
    <header class="flex items-start gap-4 sm:gap-6">
      <div class="border-border/60 bg-surface-muted h-20 w-20 shrink-0 overflow-hidden rounded-full border sm:h-24 sm:w-24">
        {user.image ? (
          <img
            src={user.image}
            alt=""
            class="h-full w-full object-cover"
            referrerpolicy="no-referrer"
          />
        ) : (
          <span class="from-brand-400 to-brand-600 text-accent-contrast flex h-full w-full items-center justify-center bg-linear-to-br text-2xl font-bold sm:text-3xl">
            {initials}
          </span>
        )}
      </div>
      <div class="min-w-0 flex-1">
        <div class="flex min-h-11 items-center gap-3">
          <h1 class="text-text-primary min-w-0 text-3xl font-black tracking-tight wrap-anywhere sm:text-4xl">
            {name}
          </h1>
          <FollowButton client:only="react" userId={user.id} />
        </div>
        <div class="text-text-muted mt-1 flex flex-col gap-x-4 gap-y-1 text-sm sm:flex-row sm:flex-wrap sm:text-lg">
          <p class="flex flex-wrap gap-x-3 gap-y-1">
            <span class="whitespace-nowrap">
              <strong class="text-text-primary">{follow.followers}</strong>{" "}
              {follow.followers === 1 ? "follower" : "followers"}
            </span>
            <span class="whitespace-nowrap">
              <strong class="text-text-primary">{follow.following}</strong>{" "}
              following
            </span>
          </p>
          <p class="flex flex-wrap gap-x-3 gap-y-1">
            <span class="whitespace-nowrap">
              {rows.length} {rows.length === 1 ? "favorite" : "favorites"}
            </span>
            <span class="whitespace-nowrap">
              {reviewCount} {reviewCount === 1 ? "review" : "reviews"}
            </span>
          </p>
        </div>
      </div>
    </header>

    {view && (
      <a
        href={profileHref}
        class="text-text-muted hover:text-text-primary focus-visible:outline-accent mt-8 inline-flex items-center gap-2 rounded-sm text-sm font-semibold focus-visible:outline-2 focus-visible:outline-offset-4"
      >
        <span aria-hidden="true">←</span> Back to profile
      </a>
    )}

    {!view && preferences?.watchlistPublic && (
      <section class="mt-10">
        <h2 class="text-xl font-bold">Watchlist</h2>
        {publicWatchlist.length ? (
          <ul class="mt-4 grid grid-cols-2 gap-5 sm:grid-cols-4">
            {publicWatchlist.map((item) => (
              <MediaCard
                href={`/${item.mediaType === "tv" ? "tv" : "movie"}?id=${item.tmdbId}`}
                title={item.title}
                poster={item.poster}
              />
            ))}
          </ul>
        ) : (
          <p>No titles on this watchlist yet.</p>
        )}
      </section>
    )}

    {view !== "reviews" && (
      <section
        id={view ? "activity" : "recently-watched"}
        class="mt-10 scroll-mt-24"
        aria-labelledby="watched-heading"
      >
        <div class="flex items-center justify-between gap-4">
          <h2
            id="watched-heading"
            class="text-text-primary text-lg font-bold tracking-tight sm:text-2xl sm:font-extrabold"
          >
            {view ? "Watch history" : "Recently watched"}
          </h2>
          {!view && log.length > 0 && (
            <a
              href={pageHref("watched")}
              class="text-accent hover:text-accent-hover focus-visible:outline-accent inline-flex shrink-0 items-center gap-2 rounded-sm text-sm font-semibold focus-visible:outline-2 focus-visible:outline-offset-4"
              aria-label={`View all of ${name}'s watches`}
            >
              View all <span aria-hidden="true">→</span>
            </a>
          )}
        </div>
        {log.length === 0 ? (
          <p class="text-text-muted mt-4 text-sm">
            {offset ? "No more watches on this page." : "Nothing logged yet."}
          </p>
        ) : (
          <ul class="mt-4 grid grid-cols-1 items-start gap-3 md:grid-cols-2">
            {log.map((entry) => {
              const { title, subtitle, code } = activityText(entry);
              const metadata = [code, subtitle].filter(Boolean).join(" · ");
              return (
                <li class="min-w-0">
                  <a
                    href={activityHref(entry)}
                    class="group border-border/60 bg-surface-muted/30 hover:border-accent/40 hover:bg-surface-muted/60 focus-visible:outline-accent flex items-start gap-4 rounded-2xl border p-4 transition-colors focus-visible:outline-2 focus-visible:outline-offset-4"
                  >
                    <div class="bg-surface-muted aspect-[2/3] w-24 shrink-0 overflow-hidden rounded-xl">
                      {entry.poster ? (
                        <img
                          src={entry.poster}
                          alt=""
                          width={96}
                          height={144}
                          loading="lazy"
                          decoding="async"
                          class="size-full object-cover"
                        />
                      ) : (
                        <span class="text-text-muted flex size-full items-center justify-center p-2 text-center text-xs">
                          No poster
                        </span>
                      )}
                    </div>
                    <div class="flex min-h-36 min-w-0 flex-1 flex-col">
                      <span class="text-accent text-[10px] font-bold tracking-wider uppercase">
                        {activityLabel(entry)}
                      </span>
                      <h3
                        class="text-text-primary mt-1 truncate text-base leading-snug font-bold sm:text-lg"
                        title={title}
                      >
                        {title}
                      </h3>
                      {metadata && (
                        <p
                          class="text-text-secondary mt-1 line-clamp-2 text-sm leading-snug wrap-anywhere"
                          title={metadata}
                        >
                          {code && (
                            <span class="whitespace-nowrap">{code}</span>
                          )}
                          {code && subtitle && " · "}
                          {subtitle}
                        </p>
                      )}
                      {entry.notes && (
                        <p
                          class="text-text-secondary mt-2 truncate text-sm"
                          title={entry.notes}
                        >
                          {entry.notes}
                        </p>
                      )}
                      <div class="text-text-muted mt-auto flex flex-wrap items-center gap-x-4 gap-y-1 pt-3 text-xs">
                        <span class="inline-flex items-center gap-1.5 whitespace-nowrap">
                          <svg
                            aria-hidden="true"
                            class="size-4 shrink-0"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.7"
                          >
                            <rect x="3" y="5" width="18" height="16" rx="2" />
                            <path
                              d="M7 3v4m10-4v4M3 11h18"
                              stroke-linecap="round"
                            />
                          </svg>
                          <span class="sr-only">Watched on </span>
                          <time datetime={entry.watchedOn}>
                            {formatDate(entry.watchedOn)}
                          </time>
                        </span>
                        {runtimePath(entry) && (
                          <ProfileRuntime
                            client:visible
                            path={runtimePath(entry)!}
                          />
                        )}
                      </div>
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>
        )}
      </section>
    )}

    {view !== "watched" && (
      <section
        id={view ? "activity" : "profile-reviews"}
        class="mt-10 scroll-mt-24"
        aria-labelledby="reviews-heading"
      >
        <div class="flex items-center justify-between gap-4">
          <h2
            id="reviews-heading"
            class="text-text-primary text-xl font-extrabold tracking-tight sm:text-2xl"
          >
            Reviews
          </h2>
          {!view && reviewCount > 0 && (
            <a
              href={pageHref("reviews")}
              class="text-accent hover:text-accent-hover focus-visible:outline-accent inline-flex shrink-0 items-center gap-2 rounded-sm text-sm font-semibold focus-visible:outline-2 focus-visible:outline-offset-4"
              aria-label={`View all of ${name}'s reviews`}
            >
              View all <span aria-hidden="true">→</span>
            </a>
          )}
        </div>
        {reviewList.length === 0 ? (
          <p class="text-text-muted mt-4 text-sm">
            {offset ? "No more reviews on this page." : "No reviews yet."}
          </p>
        ) : (
          <ul class="mt-4 space-y-3">
            {reviewList.map((review) => (
              <li class="border-border/60 bg-surface-muted/30 flex items-start gap-3 rounded-2xl border p-3 sm:gap-5 sm:p-4">
                <a
                  href={reviewHref(review)}
                  class="bg-surface-muted focus-visible:outline-accent aspect-[2/3] w-16 shrink-0 overflow-hidden rounded-xl focus-visible:outline-2 focus-visible:outline-offset-4 sm:w-20"
                  aria-label={`View ${review.title}`}
                >
                  {review.poster ? (
                    <img
                      src={review.poster}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      class="size-full object-cover"
                    />
                  ) : (
                    <span class="text-text-muted flex size-full items-center justify-center p-2 text-center text-xs">
                      No poster
                    </span>
                  )}
                </a>
                <div class="min-w-0 flex-1">
                  <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-4">
                    <h3 class="min-w-0 flex-1">
                      <a
                        href={reviewHref(review)}
                        class="text-text-primary focus-visible:outline-accent block truncate rounded-sm text-base font-bold hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 sm:text-lg"
                        title={review.title}
                      >
                        {review.title}
                      </a>
                    </h3>
                    <time
                      class="text-text-muted shrink-0 text-xs"
                      datetime={review.updatedAt.toISOString()}
                      title="Last updated"
                    >
                      {formatDate(review.updatedAt)}
                    </time>
                  </div>
                  {review.subtitle && (
                    <p
                      class="text-text-muted mt-1 truncate text-xs"
                      title={review.subtitle}
                    >
                      {review.subtitle}
                    </p>
                  )}
                  {review.rating != null && (
                    <div class="mt-2">
                      <ProfileStars rating={review.rating} />
                    </div>
                  )}
                  {review.review &&
                    (view === "reviews" ? (
                      <div class="text-text-secondary mt-3 text-sm leading-relaxed">
                        <ReviewContent review={review} />
                      </div>
                    ) : (
                      <p
                        class="text-text-secondary mt-3 line-clamp-2 text-sm leading-relaxed wrap-anywhere"
                        title={review.review}
                      >
                        {review.review}
                      </p>
                    ))}
                </div>
              </li>
            ))}
          </ul>
        )}
      </section>
    )}

    {view && (offset > 0 || hasNextPage) && (
      <nav
        aria-label={view === "watched" ? "Watch history pages" : "Review pages"}
        class="mt-6 flex items-center justify-between gap-4"
      >
        <div>
          {offset > 0 && (
            <a
              href={pageHref(view, Math.max(0, offset - limit))}
              class="border-border/60 hover:bg-surface-muted focus-visible:outline-accent inline-flex rounded-xl border px-4 py-2 text-sm font-semibold focus-visible:outline-2 focus-visible:outline-offset-4"
            >
              ← Previous
            </a>
          )}
        </div>
        <span class="text-text-muted text-sm">Page {offset / limit + 1}</span>
        <div>
          {hasNextPage && (
            <a
              href={pageHref(view, offset + limit)}
              class="border-border/60 hover:bg-surface-muted focus-visible:outline-accent inline-flex rounded-xl border px-4 py-2 text-sm font-semibold focus-visible:outline-2 focus-visible:outline-offset-4"
            >
              Next →
            </a>
          )}
        </div>
      </nav>
    )}

    {!view && (
      <>
        <h2 class="text-text-primary mt-12 text-xl font-extrabold tracking-tight">
          Favorites
        </h2>

        {rows.length === 0 ? (
          <p class="text-text-muted mt-6 text-sm">Nothing favorited yet.</p>
        ) : (
          <ul class="mt-6 grid grid-cols-2 gap-5 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
            {rows.map((movie) => (
              <MediaCard
                href={mediaHref(movie.href, movie.mediaType, movie.tmdbId)}
                title={movie.title}
                subtitle={movie.subtitle}
                poster={movie.poster}
                rating={movie.rating}
              />
            ))}
          </ul>
        )}
      </>
    )}
  </div>
  <!-- `no-store` covers the HTTP cache; this covers back/forward cache, which
       restores the old DOM without a request. -->
  <script is:inline>
    addEventListener("pageshow", (event) => {
      if (event.persisted) location.reload();
    });
  </script>
</Layout>
