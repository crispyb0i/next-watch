---
export const prerender = false;
import { getMovieDetails, posterUrl } from "../lib/tmdb";
import { TmdbError } from "../lib/server/tmdb";
import Layout from "../layouts/Layout.astro";
import MovieDetail from "../components/MovieDetail.tsx";
import { parseId } from "../components/MediaDetail";
import "../styles/global.css";

const movieId = parseId(Astro.url.searchParams.get("id"));
let data;
let failed = false;
if (movieId) {
  try {
    data = await getMovieDetails(movieId);
  } catch (error) {
    Astro.response.status = error instanceof TmdbError ? error.status : 503;
    failed = true;
  }
} else {
  Astro.response.status = 400;
}
---

<Layout
  title={data ? `${data.title} — Next Watch` : "Next Watch"}
  description={data?.overview}
  image={posterUrl(data?.poster_path ?? null, "w500") ?? undefined}
  noindex={!data}
>
  {failed ? (
    <p role="alert">
      Could not load this title.{" "}
      <a href={Astro.url.pathname + Astro.url.search}>Try again</a>
    </p>
  ) : (
    <MovieDetail movieId={movieId} initialData={data} client:load />
  )}
</Layout>
