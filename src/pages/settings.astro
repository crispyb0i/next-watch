---
import Layout from "../layouts/Layout.astro";
import AccountSettings from "../components/AccountSettings.tsx";
import "../styles/global.css";
---

<Layout>
  <div class="mx-auto w-full max-w-2xl py-8">
    <a
      href="/"
      class="text-text-muted hover:text-text-primary mb-6 inline-flex items-center gap-1.5 text-sm font-medium transition"
    >
      <span aria-hidden="true">←</span> Back to Next Watch
    </a>

    <header class="border-border/60 from-brand-600/15 rounded-card shadow-card mb-8 border bg-linear-to-br to-transparent px-6 py-7 backdrop-blur-xl">
      <h1 class="text-text-primary text-3xl font-extrabold tracking-tight text-balance">
        Account settings
      </h1>
      <p class="text-text-muted mt-1.5 text-sm">
        Update your avatar and display name, change your sign-in details, and
        review the devices where you're signed in.
      </p>
    </header>

    <AccountSettings client:load />
  </div>
</Layout>
