---
export const prerender = false;
import { getPersonDetails, profileUrl } from "../lib/tmdb";
import { TmdbError } from "../lib/server/tmdb";
import Layout from "../layouts/Layout.astro";
import PersonDetail from "../components/PersonDetail.tsx";
import { parseId } from "../components/MediaDetail";
import "../styles/global.css";

const personId = parseId(Astro.url.searchParams.get("id"));
let data;
let failed = false;
if (personId) {
  try {
    data = await getPersonDetails(personId);
  } catch (error) {
    Astro.response.status = error instanceof TmdbError ? error.status : 503;
    failed = true;
  }
} else Astro.response.status = 400;
---

<Layout
  title={data ? `${data.name} — Next Watch` : "Next Watch"}
  description={data?.biography}
  image={profileUrl(data?.profile_path ?? null) ?? undefined}
  noindex={!data}
>
  {failed ? (
    <p role="alert">
      Could not load this person.{" "}
      <a href={Astro.url.pathname + Astro.url.search}>Try again</a>
    </p>
  ) : (
    <PersonDetail personId={personId} initialData={data} client:load />
  )}
</Layout>
