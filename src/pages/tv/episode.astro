---
export const prerender = false;
import { getTvShowDetails, getEpisodeDetails } from "../../lib/tmdb";
import { TmdbError } from "../../lib/server/tmdb";
import Layout from "../../layouts/Layout.astro";
import EpisodeDetail from "../../components/EpisodeDetail.tsx";
import { parseId, parseSeasonNumber } from "../../components/MediaDetail";
import "../../styles/global.css";

const params = Astro.url.searchParams;
const tvId = parseId(params.get("id"));
const seasonNumber = parseSeasonNumber(params.get("season"));
const episodeNumber = parseId(params.get("episode"));
let data, show;
let failed = false;
if (tvId && seasonNumber != null && episodeNumber != null) {
  try {
    [show, data] = await Promise.all([
      getTvShowDetails(tvId),
      getEpisodeDetails(tvId, seasonNumber, episodeNumber),
    ]);
  } catch (error) {
    Astro.response.status = error instanceof TmdbError ? error.status : 503;
    failed = true;
  }
} else Astro.response.status = 400;
---

<Layout
  title={
    show && data ? `${show.name} · ${data.name} — Next Watch` : "Next Watch"
  }
  description={
    show ? `Track episodes of ${show.name} on Next Watch.` : undefined
  }
  noindex={!data}
>
  {failed ? (
    <p role="alert">
      Could not load this title.{" "}
      <a href={Astro.url.pathname + Astro.url.search}>Try again</a>
    </p>
  ) : (
    <EpisodeDetail
      tvId={tvId}
      seasonNumber={seasonNumber}
      episodeNumber={episodeNumber}
      initialData={data}
      initialShow={show}
      client:load
    />
  )}
</Layout>
