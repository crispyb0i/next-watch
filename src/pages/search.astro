---
export const prerender = false;

import TabView from "../components/TabView";
import Layout from "../layouts/Layout.astro";
import Search from "../components/Search.tsx";
import "../styles/global.css";

const rawTab = Astro.url.searchParams.get("tab");
const tab =
  rawTab === "movie" ||
  rawTab === "tv" ||
  rawTab === "person" ||
  rawTab === "users"
    ? rawTab
    : "all";
const rawPage = Number(Astro.url.searchParams.get("page"));
const page =
  Number.isInteger(rawPage) && rawPage > 0 ? Math.min(rawPage, 500) : 1;
const q = Astro.url.searchParams.get("q")?.trim().slice(0, 200) ?? "";
---

<Layout title={q ? `Search: ${q} — Next Watch` : "Search — Next Watch"} noindex>
  <TabView
    page="search"
    client:only="react"
    transition:persist="tab-content"
    initialQuery={q}
    initialTab={tab}
    initialPage={page}
  >
    <Search
      slot="fallback"
      initialQuery={q}
      initialTab={tab}
      initialPage={page}
    />
  </TabView>
</Layout>
