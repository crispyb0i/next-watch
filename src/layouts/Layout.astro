---
import Container from "../components/Container.astro";
import Navbar from "../components/Navbar.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Movie Search</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-surface text-text-primary min-h-screen font-sans antialiased">
    <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
      <div class="bg-accent/25 absolute -top-40 left-1/2 h-[32rem] w-[52rem] -translate-x-1/2 rounded-full blur-[120px]"></div>
      <div class="bg-brand-400/15 absolute top-1/3 -right-40 h-96 w-96 rounded-full blur-[120px]"></div>
      <div
        class="absolute inset-0 opacity-[0.15] mix-blend-overlay"
        style="background-image: radial-gradient(currentColor 1px, transparent 1px); background-size: 22px 22px;"
      ></div>
    </div>
    <Navbar />
    <Container>
      <slot />
    </Container>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }
</style>
